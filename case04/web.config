<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <cgi createProcessAsUser="false" />
    <handlers accessPolicy="Read, Script, Execute">
      <add name="TourCatalogCgi" path="TourCatalog.exe" verb="*"
           modules="CgiModule" resourceType="File" requireAccess="Execute" />
    </handlers>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
